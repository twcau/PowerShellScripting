<Window x:Class="ScriptLauncher.Views.ReassignCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reassign Scripts"
        Height="180"
        Width="360"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/remotetools.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Select target category to reassign scripts:"/>
        <ComboBox x:Name="TargetCombo"
                Grid.Row="0"
                Margin="0,24,0,0"/>
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
            <Button Width="90"
                    Height="28"
                    Margin="0,0,8,0"
                    Content="_OK"
                    IsDefault="True"
                    Click="Ok_Click"/>
            <Button Width="90"
                    Height="28"
                    Content="_Cancel"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
