<Window x:Class="ScriptLauncher.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Configuration"
        Height="220"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/remotetools.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Select what to export:"
                    Margin="0,0,0,8"/>
            <ComboBox x:Name="ScopeCombo"
                    SelectedIndex="0"
                    Height="26"
                    VerticalContentAlignment="Center">
                <ComboBoxItem Content="Both"/>
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Global"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
            <Button Content="OK"
                    Width="90"
                    IsDefault="True"
                    Click="Ok_Click"/>
            <Button Content="Cancel"
                    Width="90"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>