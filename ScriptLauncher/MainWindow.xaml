<Window x:Class="ScriptLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScriptLauncher.Converters"
        xmlns:cmd="clr-namespace:ScriptLauncher.Commands"
        Title="Script Launcher"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/remotetools.ico">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <KeyBinding Key="R"
                    Modifiers="Control"
                    Command="{x:Static cmd:AppCommands.RunScript}"/>
        <KeyBinding Gesture="Ctrl+Shift+R"
                    Command="{x:Static cmd:AppCommands.ReloadConfig}"/>
        <KeyBinding Key="I"
                    Modifiers="Control"
                    Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="E"
                    Modifiers="Control"
                    Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{x:Static cmd:AppCommands.OpenSettings}"/>
        <KeyBinding Key="H"
                    Modifiers="Control"
                    Command="{x:Static cmd:AppCommands.OpenHistory}"/>
        <KeyBinding Key="F1"
                    Command="{x:Static ApplicationCommands.Help}"/>
        <KeyBinding Key="Q"
                    Modifiers="Control"
                    Command="{x:Static ApplicationCommands.Close}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static cmd:AppCommands.RunScript}"
                        Executed="RunSelected_Executed"
                        CanExecute="RunSelected_CanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                        Executed="ImportConfig_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"
                        Executed="ExportConfig_Executed"/>
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenSettings}"
                        Executed="OpenSettings_Executed"/>
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenHistory}"
                        Executed="OpenHistory_Executed"/>
        <CommandBinding Command="{x:Static cmd:AppCommands.ReloadConfig}"
                        Executed="ReloadConfig_Executed"/>
        <!-- Preferences moved inside Settings; remove command binding -->
        <CommandBinding Command="{x:Static ApplicationCommands.Help}"
                        Executed="OpenAbout_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}"
                        Executed="Exit_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <DockPanel.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:BoolToYesNoConverter x:Key="BoolToYesNo"/>
        </DockPanel.Resources>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding ReloadHadChanges, Converter={StaticResource BoolToVisibility}}">
                <TextBlock>
                    <Hyperlink Command="{x:Static cmd:AppCommands.OpenHistory}">View changes</Hyperlink>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenuItem"
                      Header="_File">
                <MenuItem Header="Run selected script"
                          Command="{x:Static cmd:AppCommands.RunScript}"
                          InputGestureText="Ctrl+R"/>
                <Separator/>
                <MenuItem Header="_Import Config..."
                          Command="{x:Static ApplicationCommands.Open}"
                          InputGestureText="Ctrl+I"/>
                <MenuItem Header="_Export Config..."
                          Command="{x:Static ApplicationCommands.Save}"
                          InputGestureText="Ctrl+E"/>
                <MenuItem Header="_Reload Config"
                          Command="{x:Static cmd:AppCommands.ReloadConfig}"/>
                <MenuItem Header="_History"
                          Command="{x:Static cmd:AppCommands.OpenHistory}"
                          InputGestureText="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="_Settings"
                          Command="{x:Static cmd:AppCommands.OpenSettings}"
                          InputGestureText="Ctrl+S"/>
                <!-- Preferences moved into Settings; menu entry removed -->
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{x:Static ApplicationCommands.Close}"
                          InputGestureText="Ctrl+Q"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"
                          Command="{x:Static ApplicationCommands.Help}"
                          InputGestureText="F1"/>
                <MenuItem Header="Keyboard _Shortcuts"
                          Click="OpenShortcuts_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel in its own grid to avoid vertical shifts when right header grows -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Top">
                    <TextBlock Text="Categories"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <TextBlock Text="Scope:"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CategoryScopeFilterCombo"
                                  Width="160"
                                  Height="26"
                                  Margin="6,0,0,0"
                                  SelectedIndex="{Binding ScopeCategoryFilterIndex}"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Category scope filter">
                            <ComboBoxItem Content="Both"/>
                            <ComboBoxItem Content="User"/>
                            <ComboBoxItem Content="Global"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="CategoriesList"
                         Grid.Row="1"
                         ItemsSource="{Binding Categories}"
                         DisplayMemberPath="Label"
                         SelectedItem="{Binding SelectedCategory}"
                         AutomationProperties.Name="Categories list"/>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scripts header as grid for consistent Run button location -->
                <Grid Margin="0,0,0,8"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Scripts"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0,0,0">
                            <TextBlock Text="Sort:"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="SortOrderCombo"
                                      Width="140"
                                      Height="26"
                                      Margin="6,0,0,0"
                                      SelectedIndex="{Binding SortIndex}"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="A–Z"/>
                                <ComboBoxItem Content="Z–A"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="RunButton"
                            Grid.Column="1"
                            Content="_Run"
                            Margin="12,0,0,0"
                            Width="120"
                            Height="28"
                            Command="{Binding RunSelectedCommand}"
                            AutomationProperties.Name="Run selected script"/>
                </Grid>

                <DataGrid x:Name="ScriptsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ItemsSource="{Binding Scripts}"
                          SelectedItem="{Binding SelectedScriptItem}"
                          AutomationProperties.Name="Scripts grid"
                          KeyboardNavigation.TabNavigation="Once"
                          SelectionUnit="FullRow"
                          GotKeyboardFocus="ScriptsGrid_GotKeyboardFocus"
                          PreviewKeyDown="ScriptsGrid_PreviewKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height"
                                    Value="Auto"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Display Name"
                                            Binding="{Binding DisplayName}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Scope"
                                            Binding="{Binding Scope}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Runs as Admin"
                                            Binding="{Binding RequiresAdmin, Converter={StaticResource BoolToYesNo}}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>


            </Grid>
        </Grid>
    </DockPanel>
</Window>
